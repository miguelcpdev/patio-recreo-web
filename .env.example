PORT=3000
NODE_ENV=development
# Cambia esto en producción (mín. 32 caracteres)
JWT_SECRET=change-me-change-me-change-me-change-me
# Administrador inicial (se crea al arrancar si no existe ninguno)
ADMIN_EMAIL=admin@elpatiodemirecreo.com
ADMIN_PASSWORD=cambia-esta-clave
# Origen del front en desarrollo (CORS)
CLIENT_ORIGIN=http://localhost:5173
# Ruta de la base de datos SQLite
DB_PATH=./data/patio.db
